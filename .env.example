# ---------------------------------------------------------------------------
# Streamlock configuration
# Copy to .env.local and fill in. Everything here is server-side only unless
# the name starts with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Statlocker (https://statlocker.gg/api — apply for a key, reviewed by hand).
# Supplies match rosters and, critically, the `twitchUsername` on each profile.
# Without this key Streamlock falls back to Deadlock API rosters and can only
# discover Twitch accounts for players who have linked one in Streamlock itself.
STATLOCKER_API_KEY=
STATLOCKER_BASE_URL=https://statlocker.gg

# Deadlock API (https://deadlock-api.com) — free, no key required.
# Supplies the recent match list for a Steam account.
DEADLOCK_API_BASE_URL=https://api.deadlock-api.com
DEADLOCK_ASSETS_BASE_URL=https://assets.deadlock-api.com
# Optional patron key for prioritised fetching / higher rate limits.
DEADLOCK_API_KEY=

# Twitch (https://dev.twitch.tv/console/apps — create a "confidential" app).
# Client credentials are used for an app access token; no user login required
# to read public VODs.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Only needed for account linking. Must exactly match an OAuth Redirect URL
# registered on the Twitch app. Defaults to <origin>/api/auth/twitch/callback,
# so register http://localhost:3000/api/auth/twitch/callback for local dev.
TWITCH_REDIRECT_URI=

# Hostnames allowed to embed the Twitch player. The browser derives its own
# hostname automatically; add extra values here for proxied/custom domains.
# Comma-separated, no protocol, no port.
NEXT_PUBLIC_TWITCH_PARENTS=localhost

# Optional: Steam Web API key (https://steamcommunity.com/dev/apikey).
# Only needed to resolve vanity URLs like steamcommunity.com/id/somename.
STEAM_API_KEY=

# ---------------------------------------------------------------------------
# Account linking (optional)
# Lets players prove they own a Steam account and a Twitch channel, which beats
# Statlocker's self-reported username. Leave the secret blank to disable.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ---------------------------------------------------------------------------
STREAMLOCK_SESSION_SECRET=

# Public origin used to build OAuth redirect and OpenID return URLs. Leave blank
# to infer it from the request; set it when running behind a reverse proxy.
STREAMLOCK_PUBLIC_URL=

# Set to 1 to serve a canned dataset instead of calling any upstream API.
# Useful for UI work before your API keys are approved.
STREAMLOCK_DEMO=0
